{
  "name": "haccp-checklist-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:training-draft": "node --import tsx scripts/generate-baladiyah-draft-seed.ts",
    "generate:training-single-org-seed": "node --import tsx scripts/generate-baladiyah-single-active-org-seed.ts",
    "generate:training-final-assessment": "node --import tsx scripts/generate-baladiyah-final-assessment.ts",
    "validate:training-assets": "node --import tsx scripts/validate-baladiyah-photo-assets.ts",
    "dev:api": "node --env-file-if-exists=.env.backend.local --watch --import tsx src/backend/server.ts",
    "build:api": "tsc -p tsconfig.api.json",
    "start:api": "node --env-file-if-exists=.env.backend.local dist-api/server.js",
    "test:api": "node --import tsx --test src/backend/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "sharp": "^0.34.4",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
