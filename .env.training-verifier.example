# Isolated worker only. Never copy these values into the API service or browser.
TRAINING_VERIFIER_SUPABASE_URL=
TRAINING_VERIFIER_SUPABASE_PUBLISHABLE_KEY=
# Short-lived JWT with training_storage_verifier=true and matching capability/audience claims.
TRAINING_VERIFIER_STORAGE_ACCESS_TOKEN=
TRAINING_VERIFIER_CAPABILITY_ID=
TRAINING_VERIFIER_CAPABILITY_SECRET=
TRAINING_PUBLICATION_AUDIENCE=haccp.production.training-publication
# Base64(JSON object mapping key IDs to base64-encoded Ed25519 public PEM keys).
TRAINING_PUBLICATION_SIGNING_PUBLIC_KEYS_BASE64_JSON=
TRAINING_VERIFIER_POLL_INTERVAL_MS=5000
TRAINING_VERIFIER_DOWNLOAD_TIMEOUT_MS=10000
